# ==============================================================================
# NEXUS-IT — Environment Variables
# ------------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values.
#   cp .env.example .env.local
#
# `.env.local` is gitignored and must NEVER be committed.
# Restart the dev server after any change (values are read at startup).
#
# Note: if the Supabase variables are missing, the app runs in "Local UI mode"
# with a mock client (fake session, empty data) so the frontend stays testable.
# ==============================================================================


# ------------------------------------------------------------------------------
# Supabase (required)
# Database, auth, and file storage.
# Find both under: Supabase Dashboard → Project Settings → API
# ------------------------------------------------------------------------------

# Project URL, e.g. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The "anon / public" API key (a long JWT). Safe for the browser;
# row-level security policies control what it can actually do.
NEXT_PUBLIC_SUPABASE_ANON_KEY=


# ------------------------------------------------------------------------------
# Groq (optional)
# Powers the AI Advisor page via /api/advisor. Server-side only.
# Get a key at: https://console.groq.com/keys
# Without it, the advisor replies "Advisor is not configured yet."
# ------------------------------------------------------------------------------

GROQ_API_KEY=
